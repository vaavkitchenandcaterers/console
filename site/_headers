# Security headers for Netlify / Cloudflare Pages static hosting.
# (These complement the CSP <meta> tag in index.html; some headers, like
#  X-Frame-Options and HSTS, can ONLY be set here, not via <meta>.)
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' https://www.googletagmanager.com; frame-src https://www.google.com https://maps.google.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Images are cached for 30 days rather than a year with `immutable`, because
# they are not fingerprinted: the filenames carry no content hash, so a cached
# copy can only be replaced by waiting out max-age or by renaming the file.
# Thirty days removes the per-request revalidation these assets currently pay
# on every page load, while keeping the worst case bounded: a photo replaced
# in place still reaches returning visitors within a month.
#
# To publish an image change immediately, rename the file. The reference in the
# HTML changes with it, so the new URL is fetched and the old cache is bypassed.
#
# CSS and JS deliberately keep the site default (max-age=0, must-revalidate).
# They change often and are not fingerprinted either, and correctness there
# matters more than one revalidation round-trip.
/*.webp
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000

# Fonts are cached for a year and marked immutable. They are not fingerprinted
# either, but unlike a photo a font file is never swapped in place: a new
# version or subset gets a new filename, which changes the URL in /style.css
# and the preloads in tools/chrome/head-assets.html together.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
